class TestLineage:
    def test_all_31_lineage_edges(self):
        from datahub.lineage import LINEAGE_EDGES

        assert len(LINEAGE_EDGES) == 31

    def test_lineage_edges_use_valid_urns(self):
        from datahub.lineage import LINEAGE_EDGES
        from datahub.entities import DATASETS, MODELS

        all_urns = set(DATASETS.values()) | set(MODELS.values())
        for upstream, downstream, _desc in LINEAGE_EDGES:
            assert upstream in all_urns, f"Invalid upstream URN: {upstream}"
            assert downstream in all_urns, f"Invalid downstream URN: {downstream}"

    def test_chirps_to_alert_chain_connected(self):
        from datahub.lineage import LINEAGE_EDGES
        from datahub.entities import DATASETS, MODELS

        # Verify the main chain exists: CHIRPS → M1 → BMA → Kelly → Alert
        edges = set((u, d) for u, d, _ in LINEAGE_EDGES)
        assert (DATASETS["chirps"], MODELS["M1"]) in edges
        assert (MODELS["M1"], DATASETS["bma_scores"]) in edges
        assert (DATASETS["bma_scores"], MODELS["M13"]) in edges
        assert (MODELS["M13"], DATASETS["alerts"]) in edges
        assert (DATASETS["alerts"], DATASETS["sms_feedback"]) in edges

    def test_feedback_loop_present(self):
        from datahub.lineage import LINEAGE_EDGES
        from datahub.entities import DATASETS, MODELS

        edges = set((u, d) for u, d, _ in LINEAGE_EDGES)
        assert (DATASETS["sms_feedback"], MODELS["M14"]) in edges
        assert (DATASETS["sms_feedback"], MODELS["M12"]) in edges

    def test_trace_alert_lineage_has_8_steps(self):
        from datahub.lineage import trace_alert_lineage

        result = trace_alert_lineage("alert-123")
        assert result["alert_id"] == "alert-123"
        assert len(result["lineage_chain"]) == 8
        assert result["lineage_chain"][7]["entity"] == "Alert alert-123"


