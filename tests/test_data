"""HazardGraph — DataHub integration unit tests.

These tests verify the metadata registries, lineage graph, and
client URN builders without requiring a running DataHub instance.
"""

import pytest


class TestModelRegistry:
    def test_all_14_models_registered(self):
        from datahub.model_registry import MODEL_REGISTRY

        assert len(MODEL_REGISTRY) == 14

    def test_model_ids_are_m1_to_m14(self):
        from datahub.model_registry import MODEL_REGISTRY

        ids = [m.id for m in MODEL_REGISTRY]
        assert ids == [f"M{i}" for i in range(1, 15)]

    def test_every_model_has_required_fields(self):
        from datahub.model_registry import MODEL_REGISTRY

        for model in MODEL_REGISTRY:
            assert model.name
            assert model.urn_name
            assert model.category
            assert model.technique
            assert model.output_description
            assert model.update_frequency

    def test_models_have_datahub_urns(self):
        from datahub.entities import MODELS

        assert len(MODELS) == 14
        for model_id in [f"M{i}" for i in range(1, 15)]:
            assert model_id in MODELS
            assert MODELS[model_id].startswith("urn:li:mlModel:")

    def test_upstream_datasets_reference_valid_names(self):
        from datahub.model_registry import MODEL_REGISTRY

        valid = {
            "chirps_spi_horn_of_africa",
            "modis_ndvi_horn_of_africa",
            "wfp_food_prices_igad",
            "ipc_phase_reports",
            "icpac_rss_alerts",
            "bma_risk_scores_weekly",
            "all_model_outputs",
            "alert_dispatch_log",
            "farmer_sms_responses",
        }
        for model in MODEL_REGISTRY:
            if model.upstream_datasets:
                for ds in model.upstream_datasets:
                    assert ds in valid, f"{model.id} references unknown dataset {ds}"


