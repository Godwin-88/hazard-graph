        urn = client.dataset_urn("test_dataset", platform="neo4j")
        assert "urn:li:dataset:" in urn
        assert "test_dataset" in urn

    def test_model_urn_builder(self):
        from datahub.client import HazardGraphDataHubClient

        client = HazardGraphDataHubClient(gms_server="http://test", token="")
        urn = client.model_urn("test_model")
        assert "urn:li:mlModel:" in urn
