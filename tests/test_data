        # Localhost with no server should fail gracefully
        client = HazardGraphDataHubClient(gms_server="http://localhost:9", token="")
        assert client.health_check() is False


class TestMCPSyncJob:
    def test_sync_job_summary_shape(self):
        """Verify sync summary counts without emitting (no server)."""
        from datahub.sync_job import sync_all
        from datahub.client import HazardGraphDataHubClient

        class MockClient:
            def __init__(self):
                self.emitted = []

            def emit(self, mcp):
                self.emitted.append(mcp)

            def dataset_urn(self, name, platform="neo4j"):
                return f"urn:li:dataset:(urn:li:dataPlatform:{platform},{name},PROD)"

            def model_urn(self, name):
                return f"urn:li:mlModel:(urn:li:dataPlatform:hazardgraph,{name},PROD)"

        client = MockClient()
        summary = sync_all(client)
        assert summary["status"] == "synced"
        assert summary["datasets"] == 9
        assert summary["models"] == 14
        assert summary["lineage_edges"] == 31
        assert summary["assertions"] == 5