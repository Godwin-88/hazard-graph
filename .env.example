# HazardGraph — Environment Variables
# Copy to .env and fill in your credentials

# Neo4j AuraDB
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# PostgreSQL
POSTGRES_DSN=postgresql+asyncpg://user:password@host:5432/hazardgraph

# Redis (Upstash)
REDIS_URL=rediss://:<your-redis-password>@<your-redis-endpoint>:6379

# Groq API
GROQ_API_KEY=gsk_<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# App
APP_NAME=HazardGraph
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,https://hazardgraph-ui.vercel.app
LOG_LEVEL=INFO